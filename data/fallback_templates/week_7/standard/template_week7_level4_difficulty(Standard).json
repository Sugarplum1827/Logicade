  "rules": [
    {
      "on": "enemy_attack_tick",
      "if": "queue_calm > 0 && timer < 39",
      "then": [
        "queue_calm = max(0, queue_calm - 11)",
        "play_animation('hit')",
        "play_sound('impact')",
        "add_event_log('Eldritch shades attack the glyph door!')"
      ]
    },
    {
      "on": "player_press_space",
      "if": "queue_calm > 0 && queue_calm < 100 && player_energy >= 5",
      "then": [
        "queue_calm = min(100, queue_calm + 6)",
        "player_energy -= 5",
        "score += 10",
        "play_animation('repair')",
        "play_sound('repair')",
        "add_event_log('You applied the fix!')"
      ]
    },
    {
      "on": "player_press_space",
      "if": "queue_calm >= 100",
      "then": [
        "show_message('queue_calm is already full!')"
      ]
    },
    {
      "on": "player_press_space",
      "if": "player_energy < 5 && queue_calm < 100",
      "then": [
        "show_message('Not enough energy!')"
      ]
    },
    {
      "on": "wrong_code_choice",
      "if": "lives > 0",
      "then": [
        "lives -= 1",
        "play_sound('wrong')",
        "add_event_log('That choice does not match the code.')"
      ]
    },
    {
      "on": "timer_tick",
      "if": "timer < 39 && queue_calm > 0",
      "then": [
        "timer += 1",
        "score += 10",
        "player_energy = min(100, player_energy + 2)"
      ]
    },
    {
      "on": "enemy_defeated",
      "if": "queue_calm > 0",
      "then": [
        "score += 50",
        "play_sound('defeat')"
      ]
    },
    {
      "on": "meter_changed",
      "if": "queue_calm <= 30 && queue_calm > 0",
      "then": [
        "show_warning('queue_calm is about to fail!')",
        "play_animation('shaking')"
      ]
    }
  ],
