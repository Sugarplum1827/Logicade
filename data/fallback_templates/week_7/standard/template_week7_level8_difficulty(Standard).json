  "rules": [
    {
      "on": "enemy_attack_tick",
      "if": "map_cells > 0 && timer < 51",
      "then": [
        "map_cells = max(0, map_cells - 12)",
        "play_animation('hit')",
        "play_sound('impact')",
        "add_event_log('Echo phantoms attack the spirit lantern!')"
      ]
    },
    {
      "on": "player_press_space",
      "if": "map_cells > 0 && map_cells < 100 && player_energy >= 5",
      "then": [
        "map_cells = min(100, map_cells + 6)",
        "player_energy -= 5",
        "score += 10",
        "play_animation('repair')",
        "play_sound('repair')",
        "add_event_log('You applied the fix!')"
      ]
    },
    {
      "on": "player_press_space",
      "if": "map_cells >= 100",
      "then": [
        "show_message('map_cells is already full!')"
      ]
    },
    {
      "on": "player_press_space",
      "if": "player_energy < 5 && map_cells < 100",
      "then": [
        "show_message('Not enough energy!')"
      ]
    },
    {
      "on": "wrong_code_choice",
      "if": "lives > 0",
      "then": [
        "lives -= 1",
        "play_sound('wrong')",
        "add_event_log('That choice does not match the code.')"
      ]
    },
    {
      "on": "timer_tick",
      "if": "timer < 51 && map_cells > 0",
      "then": [
        "timer += 1",
        "score += 10",
        "player_energy = min(100, player_energy + 2)"
      ]
    },
    {
      "on": "enemy_defeated",
      "if": "map_cells > 0",
      "then": [
        "score += 50",
        "play_sound('defeat')"
      ]
    },
    {
      "on": "meter_changed",
      "if": "map_cells <= 30 && map_cells > 0",
      "then": [
        "show_warning('map_cells is about to fail!')",
        "play_animation('shaking')"
      ]
    }
  ],
