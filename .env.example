# ── Ollama (§2.1, §8) ──────────────────────────────────────────────────
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# Use the seven owned native Canvas games for all study weeks.
# Set to 0 only to use the optional legacy generated-game selection.
LOGICADE_NATIVE_CANVAS=1

# Automatically refill consumed Canvas slots after LLM + runtime verification.
# Run one API process (uvicorn defaults to one). Set to 0 to keep pool rotation only.
LOGICADE_CANVAS_REPLACEMENTS=1
# Node.js must be available to the server for independent runtime verification.
# LOGICADE_NODE_BINARY=C:\Program Files\nodejs\node.exe


# ── Supabase (§14.5, Phase 6) ──────────────────────────────────────────
# Leave blank until `supabase start` has been run locally.
# Copy the "API URL", "anon key", and "service_role key" printed by
# `supabase start` into these three variables. Do NOT commit a hosted
# project's keys here. Do NOT point at any URL other than your local
# stack (typically http://127.0.0.1:54321) for this build.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Required for the private, aggregate-only admin analytics endpoint.
# Generate a long random value and keep it private. It is never sent to the browser.
LOGICADE_ADMIN_KEY=
LOGICADE_ADMIN_EMAIL=kohnqui@gmail.com
# Optional dedicated HMAC key for session tokens. If unset, a key is derived
# from LOGICADE_ADMIN_KEY; changing the admin key invalidates all sessions.
LOGICADE_SESSION_SECRET=

# Optional override for the copied OpenCode library. The default is
# data/opencode_generated/dist inside this project.
# LOGICADE_GENERATED_GAMES_DIR=

# ── Demo gating (§16, Phase 8) ─────────────────────────────────────────
# Set DEMO_INTEGRATION=1 to include criteria 9–20 in `python demo.py`.
# When unset or unset-to-0, integration tests are skipped cleanly.
DEMO_INTEGRATION=0
